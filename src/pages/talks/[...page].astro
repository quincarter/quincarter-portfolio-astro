---
import type {
  FrontmatterPage,
  IFrontmatter,
} from 'astro-boilerplate-components';
import {
  BlogGallery,
  NewerOlderPagination,
  PaginationHeader,
  Section,
} from 'astro-boilerplate-components';

import { CTA } from '@/partials/CTA';
import Base from '@/templates/Base.astro';
import { AppConfig } from '@/utils/AppConfig';
import { sortByDate } from '@/utils/Posts';
import type { MarkdownInstance } from 'astro';

import '../../styles/blog-gallery.css';

type GetStaticPaths = {
  paginate: any;
}; // Overrides `GetStaticPathsOptions` types from Astro

export async function getStaticPaths({ paginate }: GetStaticPaths) {
  const allPosts = await import.meta.glob<MarkdownInstance<IFrontmatter>>(
    './*.mdx',
    { eager: true },
  );
  const postList = Object.values(allPosts).filter(
    (post) => post.frontmatter?.pubDate && post.frontmatter?.imgSrc,
  );
  const sortedPosts = sortByDate(postList);

  // Return a paginated collection of paths for all posts
  return paginate(sortedPosts, { pageSize: 6 });
}

interface Props {
  page: FrontmatterPage;
}

const { page } = Astro.props as Props;
const titleSuffix = ` - ${AppConfig.site_name}`;
const titleBase = `Tech Talk page ${page.currentPage}`;
const title = titleBase + titleSuffix;
const description =
  'These are all of my most recent tech talks/workshops - if I have a video recording of the talk, I will share it with the slide deck (if available). This may also include Youtube content.';
---

<Base head={{ title, description }}>
  <Section>
    <PaginationHeader
      title='Tech Talks/Workshops'
      description={description}
    />
  </Section>

  <Section>
    <div class="blog-gallery">
      <BlogGallery postList={page.data} />
    </div>
  </Section>

  <Section>
    <NewerOlderPagination page={page} />
  </Section>

  <CTA />
</Base>
